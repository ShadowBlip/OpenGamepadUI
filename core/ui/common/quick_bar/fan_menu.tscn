[gd_scene load_steps=6 format=3]

[ext_resource type="Script" path="res://core/ui/common/quick_bar/fan_menu.gd" id="1_fan"]
[ext_resource type="PackedScene" path="res://core/systems/input/focus_group.tscn" id="2_focus"]
[ext_resource type="Resource" path="res://core/ui/card_ui/quick_bar/quick_bar_menu_focus.tres" id="3_stack"]
[ext_resource type="PackedScene" path="res://core/ui/components/dropdown.tscn" id="4_dropdown"]
[ext_resource type="PackedScene" path="res://core/ui/components/slider.tscn" id="5_slider"]

[node name="Fan" type="VBoxContainer"]
anchors_preset = 10
anchor_right = 1.0
grow_horizontal = 2
